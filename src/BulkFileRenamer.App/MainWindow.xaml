<Window x:Class="BulkFileRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BulkFileRenamer.App.ViewModels"
        xmlns:core="clr-namespace:BulkFileRenamer.Core;assembly=BulkFileRenamer.Core"
        xmlns:rules="clr-namespace:BulkFileRenamer.Core.Rules;assembly=BulkFileRenamer.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Bulk File Renamer" Height="640" Width="960" MinHeight="480" MinWidth="780">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Add files..." Command="{Binding AddFilesCommand}" Padding="10,4" Margin="0,0,6,0" />
            <Button Content="Add folder..." Command="{Binding AddFolderCommand}" Padding="10,4" Margin="0,0,6,0" />
            <Button Content="Clear" Command="{Binding ClearCommand}" Padding="10,4" />
        </StackPanel>

        <!-- Rule panel -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Rules (applied in order)" FontWeight="Bold" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="1. Find" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="4,0,12,0"
                             Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Replace with" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Margin="4,0,12,0"
                             Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="4" Content="Match case" IsChecked="{Binding MatchCase}"
                              VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="2. Remove chars" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="4,0,12,0"
                             Text="{Binding RemoveChars, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="3. Change case" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Content="Enable" IsChecked="{Binding ChangeCaseEnabled}"
                              VerticalAlignment="Center" Margin="4,0,12,0" />
                    <ComboBox Grid.Column="2" Width="120"
                              ItemsSource="{Binding CaseModes}"
                              SelectedItem="{Binding CaseMode}" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="4. Prefix" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="4,0,12,0"
                             Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="5. Suffix" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Margin="4,0,12,0"
                             Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="6. Numbering" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Content="Enable" IsChecked="{Binding NumberingEnabled}"
                              VerticalAlignment="Center" Margin="4,0,12,0" />
                    <TextBlock Grid.Column="2" Text="Start:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Width="50" Margin="4,0,8,0"
                             Text="{Binding NumberingStart, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Step:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="5" Width="40" Margin="4,0,8,0"
                             Text="{Binding NumberingStep, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="6" Text="Pad:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="7" Width="40" Margin="4,0,12,0"
                             Text="{Binding NumberingPadding, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="8" Width="80" Margin="0,0,8,0"
                              ItemsSource="{Binding NumberingPositions}"
                              SelectedItem="{Binding NumberingPosition}" />
                    <TextBox Grid.Column="9" Width="40"
                             Text="{Binding NumberingSeparator, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Preview grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Files}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  AllowDrop="True" Drop="OnFilesDrop" PreviewDragOver="OnFilesDragOver"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Old name" Binding="{Binding OldName}" Width="*" />
                <DataGridTextColumn Header="New name" Binding="{Binding NewName}" Width="*" />
                <DataGridTemplateColumn Header="Conflict" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="!" HorizontalAlignment="Center" Foreground="Red"
                                       FontWeight="Bold" Visibility="{Binding HasConflict,
                                       Converter={StaticResource BoolToVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasConflict}" Value="True">
                            <Setter Property="Background" Value="#FFEEEE" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,10,0,4" Foreground="#555" />

        <!-- Apply / Undo -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Undo" Command="{Binding UndoCommand}" Padding="14,6" Margin="0,0,6,0" />
            <Button Content="Apply renames" Command="{Binding ApplyCommand}" Padding="14,6"
                    FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
